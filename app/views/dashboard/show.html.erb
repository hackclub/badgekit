<div class="min-h-screen bg-gray-50 py-12 px-4">
  <div class="max-w-md mx-auto bg-white rounded-xl shadow-md p-8">
    <div class="flex justify-between items-center mb-8">
      <h1 class="text-2xl font-bold text-gray-900">Dashboard</h1>
      <%= button_to "Logout", logout_path, method: :delete, class: "text-gray-500 hover:text-gray-700" %>
    </div>

    <% if notice %>
      <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
        <%= notice %>
      </div>
    <% end %>

    <div class="mb-6">
      <p class="text-gray-600">Welcome, <span class="font-medium"><%= @user.slack_id %></span></p>
      <p class="text-sm text-gray-500 mt-1">Your link: <code class="bg-gray-100 px-2 py-1 rounded"><%= redirect_url(slack_id: @user.slack_id) %></code></p>
    </div>

    <%= form_with model: @user, url: dashboard_path, method: :patch, class: "space-y-4" do |f| %>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Redirect URL</label>
        <%= f.text_field :redirect_url, placeholder: "https://example.com", class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
        <% if @user.errors[:redirect_url].any? %>
          <p class="text-red-500 text-sm mt-1"><%= @user.errors[:redirect_url].first %></p>
        <% end %>
      </div>

      <%= f.submit "Save", class: "w-full bg-blue-600 text-white px-4 py-2 rounded-lg font-medium hover:bg-blue-700 transition cursor-pointer" %>
    <% end %>
  </div>
</div>
